#!/usr/bin/env python3
"""Keep live Herdr panes at chosen widths in terminal columns."""

import fcntl
import json
import math
import os
from pathlib import Path
import signal
import subprocess
import sys
import termios
import time

DEFAULT_COLUMNS = 90
DEFAULT_STEP = 10
MIN_COLUMNS = 40


def command(*args):
    completed = subprocess.run(
        [os.environ.get("HERDR_BIN_PATH", "herdr"), *map(str, args)],
        capture_output=True, text=True,
    )
    if completed.returncode:
        raise RuntimeError(completed.stderr.strip() or completed.stdout.strip())
    if not completed.stdout.strip():
        return None
    return json.loads(completed.stdout).get("result")


def config():
    directory = os.environ.get("HERDR_PLUGIN_CONFIG_DIR")
    if not directory:
        directory = (Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
                     / "herdr" / "plugins" / "config" / "coryfklein.herdr-layout")
    path = Path(directory, "config.json")
    data = json.loads(path.read_text()) if path.exists() else {}
    columns = data.get("columns", DEFAULT_COLUMNS)
    step = data.get("resize_step", DEFAULT_STEP)
    if (type(columns) is not int or type(step) is not int
            or columns < MIN_COLUMNS or step < 1):
        raise ValueError("columns must be at least 40 and resize_step must be positive integers")
    return columns, step


def layout(pane_id):
    return command("pane", "layout", "--pane", pane_id)["layout"]


def geometry(pane_id):
    data = layout(pane_id)
    pane = next(item for item in data["panes"] if item["pane_id"] == pane_id)
    return {
        "tab": data["tab_id"],
        "zoomed": data["zoomed"],
        "pane_width": pane["rect"]["width"],
        "pane_x": pane["rect"]["x"],
    }


def group_width(data, state):
    pane_ids = (state["pane"], state["left"], state["right"])
    rects = [item["rect"] for item in data["panes"]
             if item["pane_id"] in pane_ids]
    if len(rects) != sum(pane_id is not None for pane_id in pane_ids):
        raise ValueError("layout margin is missing")
    return max(rect["x"] + rect["width"] for rect in rects) - min(
        rect["x"] for rect in rects
    )


def placement(width, requested, alignment, offset=0):
    if width < 20:
        raise ValueError("terminal is too narrow for layout panes")
    minimum = max(1, math.ceil(width * 0.1) - 1)
    if alignment in ("left", "right"):
        columns = min(requested, width - minimum - 1)
    else:
        columns = min(requested, width - 2 * minimum - 2)
    if columns < 2:
        raise ValueError("terminal is too narrow for layout panes")
    if alignment == "left":
        return columns, 0, width - columns - 1
    if alignment == "right":
        return columns, width - columns - 1, 0
    room = width - columns - 2
    left = max(minimum, min(room - minimum, room // 2 + offset))
    return columns, left, room - left


def split(pane):
    result = command(
        "plugin", "pane", "open", "--plugin", "coryfklein.herdr-layout",
        "--entrypoint", "spacer", "--placement", "split",
        "--target-pane", pane, "--direction", "right", "--no-focus",
    )
    return result["plugin_pane"]["pane"]["pane_id"]


def close(pane):
    if pane:
        try:
            command("pane", "close", pane)
        except RuntimeError:
            pass


def margins(pane, requested, alignment, offset):
    width = geometry(pane)["pane_width"]
    columns, left_width, right_width = placement(width, requested, alignment, offset)
    if left_width == 0:
        right = split(pane)
        try:
            correct_width(pane, None, right, columns)
        except Exception:
            close(right)
            raise
        return None, right, width
    left = split(pane)
    try:
        command("pane", "swap", "--source-pane", pane, "--target-pane", left)
        correct_left_width(left, left_width, width)
        if right_width == 0:
            correct_width(pane, left, None, columns)
            return left, None, width
        right = split(pane)
        try:
            correct_width(pane, left, right, columns)
        except Exception:
            close(right)
            raise
        return left, right, width
    except Exception:
        close(left)
        raise


def correct_width(pane, left, right, columns):
    for _ in range(8):
        current = geometry(pane)
        difference = current["pane_width"] - columns
        if difference == 0:
            return
        if right:
            right_edge = geometry(right)
            parent_width = right_edge["pane_x"] + right_edge["pane_width"] - current["pane_x"]
            target = right if difference > 0 else pane
            direction = "left" if difference > 0 else "right"
        else:
            left_edge = geometry(left)
            parent_width = current["pane_x"] + current["pane_width"] - left_edge["pane_x"]
            target = left if difference > 0 else pane
            direction = "right" if difference > 0 else "left"
        amount = abs(difference) if abs(difference) > 1 else 0.25
        command("pane", "resize", "--pane", target, "--direction", direction,
                "--amount", amount / parent_width)


def move_back(pane, tab, placeholder):
    result = command("pane", "move", pane, "--tab", tab, "--split", "right",
                     "--target-pane", placeholder, "--ratio", "0.5", "--focus")
    return result.get("pane", result.get("move_result", {}).get("pane"))["pane_id"]


def enter(pane, columns):
    original = geometry(pane)
    if original["zoomed"]:
        command("pane", "zoom", pane, "--off")
    try:
        left, right, width = margins(pane, columns, "center", 0)
    except Exception:
        if original["zoomed"]:
            command("pane", "zoom", pane, "--on")
        raise
    return {
        "pane": pane, "tab": original["tab"],
        "left": left, "right": right, "columns": columns,
        "alignment": "center", "offset": 0, "zoomed": original["zoomed"],
        "area_width": width, "watch_id": time.time_ns(),
    }


def leave(state):
    close(state["left"])
    close(state["right"])
    if "placeholder" in state:
        pane = move_back(state["pane"], state["source_tab"], state["placeholder"])
        close(state["placeholder"])
    else:
        pane = state["pane"]
    if state["zoomed"]:
        command("pane", "zoom", pane, "--on")


def correct_left_width(left, target, width):
    for _ in range(8):
        difference = target - geometry(left)["pane_width"]
        if difference == 0:
            return
        direction = "right" if difference > 0 else "left"
        amount = abs(difference) if abs(difference) > 1 else 0.25
        command("pane", "resize", "--pane", left, "--direction", direction,
                "--amount", amount / width)


def rebuild(state):
    width = group_width(layout(state["pane"]), state)
    columns, left_width, right_width = placement(
        width, state["columns"], state["alignment"], state["offset"]
    )
    if left_width == 0 and state["left"] and state["right"]:
        close(state["left"])
        state["left"] = None
    elif right_width == 0 and state["left"] and state["right"]:
        close(state["right"])
        state["right"] = None
    if (bool(state["left"]) == bool(left_width)
            and bool(state["right"]) == bool(right_width)):
        if state["left"] and state["right"]:
            correct_left_width(state["left"], left_width, width)
        correct_width(state["pane"], state["left"], state["right"], columns)
        state["area_width"] = width
        return
    close(state["left"])
    close(state["right"])
    state["left"] = state["right"] = None
    left, right, width = margins(
        state["pane"], state["columns"], state["alignment"], state["offset"]
    )
    state.update(left=left, right=right, area_width=width)


def focus_content(state):
    if state["left"]:
        command("pane", "focus", "--pane", state["left"], "--direction", "right")
    elif state["right"]:
        command("pane", "focus", "--pane", state["right"], "--direction", "left")


def state_directory():
    directory = os.environ.get("HERDR_PLUGIN_STATE_DIR")
    if directory:
        return Path(directory)
    return (Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
            / "herdr" / "plugins" / "coryfklein.herdr-layout")


class LockedState:
    def __enter__(self):
        self.directory = state_directory()
        self.directory.mkdir(parents=True, exist_ok=True)
        self.lock = (self.directory / "state.lock").open("a+")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        path = self.directory / "state.json"
        self.states = json.loads(path.read_text()) if path.exists() else {}
        return self

    def save(self):
        temporary = self.directory / f"state.{os.getpid()}.tmp"
        temporary.write_text(json.dumps(self.states))
        os.replace(temporary, self.directory / "state.json")

    def __exit__(self, *_):
        fcntl.flock(self.lock, fcntl.LOCK_UN)
        self.lock.close()


def state_key(socket, pane):
    return json.dumps([socket, pane], separators=(",", ":"))


def in_layout_tab(state, tab):
    if "placeholder" in state:
        return tab != state["source_tab"]
    return tab == state["tab"]


def migrate_legacy_state(locked, socket):
    state = locked.states.pop(socket, None)
    if not state:
        return
    key = state_key(socket, state["pane"])
    try:
        active = in_layout_tab(state, geometry(state["pane"])["tab"])
    except Exception:
        active = False
    if active and key not in locked.states:
        locked.states[key] = state
        locked.save()
        start_watcher(socket, state["pane"], state["watch_id"])
    else:
        locked.save()


def focused_state(locked, socket, pane):
    for key, state in locked.states.items():
        if (key == state_key(socket, state["pane"])
                and pane in (state["pane"], state["left"], state["right"])):
            return key, state
    return None, None


def start_watcher(socket, pane, watch_id):
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "watch", str(watch_id), pane],
        env={**os.environ, "HERDR_SOCKET_PATH": socket},
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True,
    )


def action(name):
    socket = os.environ["HERDR_SOCKET_PATH"]
    pane = os.environ["HERDR_PANE_ID"]
    with LockedState() as locked:
        migrate_legacy_state(locked, socket)
        key, state = focused_state(locked, socket, pane)
        if state:
            try:
                current = layout(state["pane"])
                stale = not in_layout_tab(state, current["tab_id"])
                if not stale:
                    group_width(current, state)
            except Exception:
                stale = True
            if stale:
                del locked.states[key]
                locked.save()
                key = None
                state = None
        if name in ("toggle", "enter", "leave"):
            if state and name == "enter":
                if pane != state["pane"]:
                    raise ValueError("layout is active in another pane")
                return
            if state and name in ("toggle", "leave"):
                if pane not in (state["pane"], state["left"], state["right"]):
                    raise ValueError("focus a layout pane first")
                leave(state)
                del locked.states[key]
                locked.save()
            elif not state and name in ("toggle", "enter"):
                default_columns, _ = config()
                state = enter(pane, default_columns)
                key = state_key(socket, state["pane"])
                locked.states[key] = state
                try:
                    locked.save()
                except Exception:
                    leave(state)
                    raise
                start_watcher(socket, state["pane"], state["watch_id"])
            return
        if not state:
            raise ValueError("layout is not active")
        if pane not in (state["pane"], state["left"], state["right"]):
            raise ValueError("focus a layout pane first")
        default_columns, step = config()
        if name == "wider":
            state["columns"] += step
        elif name == "narrower":
            state["columns"] = max(MIN_COLUMNS, state["columns"] - step)
        elif name == "reset-width":
            state["columns"] = default_columns
        elif name == "center":
            state.update(alignment="center", offset=0)
        elif name in ("align-left", "align-right"):
            state.update(alignment=name.removeprefix("align-"), offset=0)
        elif name in ("move-left", "move-right"):
            delta = -step if name == "move-left" else step
            if state["alignment"] in ("left", "right"):
                width = group_width(layout(state["pane"]), state)
                _, centered_left, _ = placement(width, state["columns"], "center")
                state["offset"] = (
                    -centered_left if state["alignment"] == "left"
                    else width - state["columns"] - 1 - centered_left
                )
            state["alignment"] = "offset"
            state["offset"] += delta
        else:
            raise ValueError(f"unknown action: {name}")
        rebuild(state)
        locked.save()
        focus_content(state)


def watch(watch_id, pane):
    socket = os.environ["HERDR_SOCKET_PATH"]
    key = state_key(socket, pane)
    while True:
        time.sleep(0.6)
        with LockedState() as locked:
            state = locked.states.get(key)
            if not state or state["watch_id"] != watch_id:
                return
            try:
                current = layout(state["pane"])
                width = group_width(current, state)
            except Exception:
                return
            if not in_layout_tab(state, current["tab_id"]):
                return
            if width != state["area_width"]:
                rebuild(state)
                locked.save()


def spacer_loop():
    if os.isatty(0):
        attributes = termios.tcgetattr(0)
        attributes[3] &= ~(termios.ECHO | termios.ICANON)
        attributes[6][termios.VMIN] = 1
        attributes[6][termios.VTIME] = 0
        termios.tcsetattr(0, termios.TCSANOW, attributes)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGQUIT, signal.SIG_IGN)
    sys.stdout.write("\x1b[2J\x1b[H\x1b[?25l")
    sys.stdout.flush()
    while True:
        if os.isatty(0):
            os.read(0, 4096)
        else:
            time.sleep(3600)


if __name__ == "__main__":
    try:
        if len(sys.argv) < 2:
            raise ValueError("expected a plugin action")
        if sys.argv[1] == "spacer":
            spacer_loop()
        elif sys.argv[1] == "watch":
            watch(int(sys.argv[2]), sys.argv[3])
        else:
            action(sys.argv[1])
    except (OSError, ValueError, RuntimeError, KeyError, StopIteration) as error:
        print(f"herdr-layout: {error}", file=sys.stderr)
        sys.exit(1)
